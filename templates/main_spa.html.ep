<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
  	<title><%= $title %></title>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/css/bootstrap.min.css" integrity="sha384-Vkoo8x4CGsO3+Hhxv8T/Q5PaXtkKtu6ug5TOeNV6gBiFeWPGFN9MuhOf23Q9Ifjh" crossorigin="anonymous">
  </head>
  <body>

	<div id="list-content" class="container">
		<div id="form-content" class="container mb-5 p-3 text-white bg-secondary border">
			<form id="item-form"
				hx-post="/add"
				hx-target="#list-items"
				hx-swap="afterbegin">
				<div class="container">
					<label for="key_label" class="form-label fw-bold">Label:</label>
					<input type="text" class="form-control" id="key_label" name="label" value="asdfasf" required>
				</div>

				<div class="container pt-2">
					<label for="key_description" class="form-label fw-bold">Description:</label>
					<input type="text" class="form-control" id="key_description" name="description" placeholder="optional description">
				</div>

				<div class="container d-flex justify-content-end pt-2 pr-2">
					<button
						type="submit"
						name="action"
						value="add"
						class="btn btn-primary"
					>Add</button>
				</div>
			</form>
		</div>

		<div id="list-items" class="container">
			<% foreach my $item ( sort { $a->epoch_added <=> $b->epoch_added } $items->@* ) { next if $item->deleted; %>
				<%= include 'partials/list-item', item => $item %>
			<% } %>
		</div>

	</div>

	<script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.8/dist/htmx.min.js" integrity="sha384-/TgkGk7p307TH7EXJDuUlgG3Ce1UVolAOFopFekQkkXihi5u/6OCvVKyz1W+idaz" crossorigin="anonymous" defer></script>
	<script src="https://code.jquery.com/jquery-3.4.1.slim.min.js" integrity="sha384-J6qa4849blE2+poT4WnyKhv5vZF5SrPo0iEjwBvKU7imGFAV0wwj1yYfoRSJoZ+n" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js" integrity="sha384-Q6E9RHvbIyZFJoft+2mJbHaEWldlvI9IOYy5n3zV9zzTtmI3UksdQRVvoxMfooAo" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/js/bootstrap.min.js" integrity="sha384-wfSDF2E50Y2D1uUdj0O3uMBJnjuUD4Ih7YwaYd1iqfktj0Uod8GCExl3Og8ifwB6" crossorigin="anonymous"></script>
  </body>
</html>
